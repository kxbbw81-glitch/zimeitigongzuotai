{
  "manifest_version": 3,
  "name": "社媒工作台",
  "version": "1.0.0",
  "description": "外贸社媒 + 自媒体一体化工作台：今日待发、逾期提醒、待办速览，侧边栏常驻",
  "permissions": ["storage", "alarms", "notifications", "sidePanel"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "社媒工作台 · 今日速览",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://media-workbench-64130.app.workbuddy.host/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
